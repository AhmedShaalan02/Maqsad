{"verses":[{"id":5801,"verse_number":1,"verse_key":"81:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","transliteration":"Izash shamsu kuwwirat","translations":[{"text":"When the sun is wrapped up [in darkness]"}]},{"id":5802,"verse_number":2,"verse_key":"81:2","text_uthmani":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","transliteration":"Wa izan nujoomun kadarat","translations":[{"text":"And when the stars fall, dispersing,"}]},{"id":5803,"verse_number":3,"verse_key":"81:3","text_uthmani":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","transliteration":"Wa izal jibaalu suyyirat","translations":[{"text":"And when the mountains are removed"}]},{"id":5804,"verse_number":4,"verse_key":"81:4","text_uthmani":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","transliteration":"Wa izal 'ishaaru 'uttilat","translations":[{"text":"And when full-term she-camels are neglected"}]},{"id":5805,"verse_number":5,"verse_key":"81:5","text_uthmani":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","transliteration":"Wa izal wuhooshu hushirat","translations":[{"text":"And when the wild beasts are gathered"}]},{"id":5806,"verse_number":6,"verse_key":"81:6","text_uthmani":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","transliteration":"Wa izal bihaaru sujjirat","translations":[{"text":"And when the seas are filled with flame"}]},{"id":5807,"verse_number":7,"verse_key":"81:7","text_uthmani":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","transliteration":"Wa izan nufoosu zuwwijat","translations":[{"text":"And when the souls are paired"}]},{"id":5808,"verse_number":8,"verse_key":"81:8","text_uthmani":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","transliteration":"Wa izal maw'oodatu su'ilat","translations":[{"text":"And when the girl [who was] buried alive is asked"}]},{"id":5809,"verse_number":9,"verse_key":"81:9","text_uthmani":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","transliteration":"Bi ayyi zambin qutilat","translations":[{"text":"For what sin she was killed"}]},{"id":5810,"verse_number":10,"verse_key":"81:10","text_uthmani":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","transliteration":"Wa izas suhufu nushirat","translations":[{"text":"And when the pages are made public"}]},{"id":5811,"verse_number":11,"verse_key":"81:11","text_uthmani":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","transliteration":"Wa izas samaaa'u kushitat","translations":[{"text":"And when the sky is stripped away"}]},{"id":5812,"verse_number":12,"verse_key":"81:12","text_uthmani":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","transliteration":"Wa izal jaheemu su'-'irat","translations":[{"text":"And when Hellfire is set ablaze"}]},{"id":5813,"verse_number":13,"verse_key":"81:13","text_uthmani":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","transliteration":"Wa izal jannatu uzlifat","translations":[{"text":"And when Paradise is brought near,"}]},{"id":5814,"verse_number":14,"verse_key":"81:14","text_uthmani":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","transliteration":"'Alimat nafsum maaa ahdarat","translations":[{"text":"A soul will [then] know what it has brought [with it]."}]},{"id":5815,"verse_number":15,"verse_key":"81:15","text_uthmani":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","transliteration":"Falaaa uqsimu bil khunnas","translations":[{"text":"So I swear by the retreating stars -"}]},{"id":5816,"verse_number":16,"verse_key":"81:16","text_uthmani":"ٱلْجَوَارِ ٱلْكُنَّسِ","transliteration":"Al jawaaril kunnas","translations":[{"text":"Those that run [their courses] and disappear -"}]},{"id":5817,"verse_number":17,"verse_key":"81:17","text_uthmani":"وَٱلَّيْلِ إِذَا عَسْعَسَ","transliteration":"Wallaili izaa 'as'as","translations":[{"text":"And by the night as it closes in"}]},{"id":5818,"verse_number":18,"verse_key":"81:18","text_uthmani":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","transliteration":"Wassubhi izaa tanaffas","translations":[{"text":"And by the dawn when it breathes"}]},{"id":5819,"verse_number":19,"verse_key":"81:19","text_uthmani":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","transliteration":"Innahoo laqawlu rasoolin kareem","translations":[{"text":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"}]},{"id":5820,"verse_number":20,"verse_key":"81:20","text_uthmani":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","transliteration":"Zee quwwatin 'inda zil 'arshi makeen","translations":[{"text":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],"}]},{"id":5821,"verse_number":21,"verse_key":"81:21","text_uthmani":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","transliteration":"Mutaa'in samma ameen","translations":[{"text":"Obeyed there [in the heavens] and trustworthy."}]},{"id":5822,"verse_number":22,"verse_key":"81:22","text_uthmani":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","transliteration":"Wa maa saahibukum bimajnoon","translations":[{"text":"And your companion is not [at all] mad."}]},{"id":5823,"verse_number":23,"verse_key":"81:23","text_uthmani":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","transliteration":"Wa laqad ra aahu bilufuqil mubeen","translations":[{"text":"And he has already seen Gabriel in the clear horizon."}]},{"id":5824,"verse_number":24,"verse_key":"81:24","text_uthmani":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","transliteration":"Wa maa huwa 'alal ghaibi bidaneen","translations":[{"text":"And Muhammad is not a withholder of [knowledge of] the unseen."}]},{"id":5825,"verse_number":25,"verse_key":"81:25","text_uthmani":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","transliteration":"Wa maa huwa biqawli shaitaanir rajeem","translations":[{"text":"And the Qur'an is not the word of a devil, expelled [from the heavens]."}]},{"id":5826,"verse_number":26,"verse_key":"81:26","text_uthmani":"فَأَيْنَ تَذْهَبُونَ","transliteration":"Fa ayna tazhaboon","translations":[{"text":"So where are you going?"}]},{"id":5827,"verse_number":27,"verse_key":"81:27","text_uthmani":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","transliteration":"In huwa illaa zikrul lil'aalameen","translations":[{"text":"It is not except a reminder to the worlds"}]},{"id":5828,"verse_number":28,"verse_key":"81:28","text_uthmani":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","transliteration":"Liman shaaa'a minkum ai yastaqeem","translations":[{"text":"For whoever wills among you to take a right course."}]},{"id":5829,"verse_number":29,"verse_key":"81:29","text_uthmani":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","transliteration":"Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen","translations":[{"text":"And you do not will except that Allah wills - Lord of the worlds."}]}]}