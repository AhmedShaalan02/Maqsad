{"verses":[{"id":6107,"verse_number":1,"verse_key":"96:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","transliteration":"Iqra bismi rab bikal lazee khalaq","translations":[{"text":"Recite in the name of your Lord who created -"}]},{"id":6108,"verse_number":2,"verse_key":"96:2","text_uthmani":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","transliteration":"Khalaqal insaana min 'alaq","translations":[{"text":"Created man from a clinging substance."}]},{"id":6109,"verse_number":3,"verse_key":"96:3","text_uthmani":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","transliteration":"Iqra wa rab bukal akram","translations":[{"text":"Recite, and your Lord is the most Generous -"}]},{"id":6110,"verse_number":4,"verse_key":"96:4","text_uthmani":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","transliteration":"Al lazee 'allama bil qalam","translations":[{"text":"Who taught by the pen -"}]},{"id":6111,"verse_number":5,"verse_key":"96:5","text_uthmani":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","transliteration":"'Al lamal insaana ma lam y'alam","translations":[{"text":"Taught man that which he knew not."}]},{"id":6112,"verse_number":6,"verse_key":"96:6","text_uthmani":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","transliteration":"Kallaa innal insaana layatghaa","translations":[{"text":"No! [But] indeed, man transgresses"}]},{"id":6113,"verse_number":7,"verse_key":"96:7","text_uthmani":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","transliteration":"Ar-ra aahus taghnaa","translations":[{"text":"Because he sees himself self-sufficient."}]},{"id":6114,"verse_number":8,"verse_key":"96:8","text_uthmani":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","transliteration":"Innna ilaa rabbikar ruj'aa","translations":[{"text":"Indeed, to your Lord is the return."}]},{"id":6115,"verse_number":9,"verse_key":"96:9","text_uthmani":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","transliteration":"Ara-aital lazee yanhaa","translations":[{"text":"Have you seen the one who forbids"}]},{"id":6116,"verse_number":10,"verse_key":"96:10","text_uthmani":"عَبْدًا إِذَا صَلَّىٰٓ","transliteration":"'Abdan iza sallaa","translations":[{"text":"A servant when he prays?"}]},{"id":6117,"verse_number":11,"verse_key":"96:11","text_uthmani":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","transliteration":"Ara-aita in kana 'alal hudaa","translations":[{"text":"Have you seen if he is upon guidance"}]},{"id":6118,"verse_number":12,"verse_key":"96:12","text_uthmani":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","transliteration":"Au amara bit taqwaa","translations":[{"text":"Or enjoins righteousness?"}]},{"id":6119,"verse_number":13,"verse_key":"96:13","text_uthmani":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","transliteration":"Ara-aita in kaz zaba wa ta walla","translations":[{"text":"Have you seen if he denies and turns away -"}]},{"id":6120,"verse_number":14,"verse_key":"96:14","text_uthmani":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","transliteration":"Alam y'alam bi-an nal lahaa yaraa","translations":[{"text":"Does he not know that Allah sees?"}]},{"id":6121,"verse_number":15,"verse_key":"96:15","text_uthmani":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","transliteration":"Kalla la illam yantahi la nasfa'am bin nasiyah","translations":[{"text":"No! If he does not desist, We will surely drag him by the forelock -"}]},{"id":6122,"verse_number":16,"verse_key":"96:16","text_uthmani":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","transliteration":"Nasiyatin kazi batin khaatiyah","translations":[{"text":"A lying, sinning forelock."}]},{"id":6123,"verse_number":17,"verse_key":"96:17","text_uthmani":"فَلْيَدْعُ نَادِيَهُۥ","transliteration":"Fal yad'u naadiyah","translations":[{"text":"Then let him call his associates;"}]},{"id":6124,"verse_number":18,"verse_key":"96:18","text_uthmani":"سَنَدْعُ ٱلزَّبَانِيَةَ","transliteration":"Sanad 'uz zabaaniyah","translations":[{"text":"We will call the angels of Hell."}]},{"id":6125,"verse_number":19,"verse_key":"96:19","text_uthmani":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","transliteration":"Kalla; la tuti'hu wasjud waqtarib","translations":[{"text":"No! Do not obey him. But prostrate and draw near [to Allah]."}]}]}