{"verses":[{"id":6180,"verse_number":1,"verse_key":"104:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","transliteration":"Wai lul-li kulli hu mazatil-lumaza","translations":[{"text":"Woe to every scorner and mocker"}]},{"id":6181,"verse_number":2,"verse_key":"104:2","text_uthmani":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","transliteration":"Al-lazi jama'a maalaw wa'addadah","translations":[{"text":"Who collects wealth and [continuously] counts it."}]},{"id":6182,"verse_number":3,"verse_key":"104:3","text_uthmani":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","transliteration":"Yahsabu anna maalahu akhladah","translations":[{"text":"He thinks that his wealth will make him immortal."}]},{"id":6183,"verse_number":4,"verse_key":"104:4","text_uthmani":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","transliteration":"Kalla layum ba zanna fil hutamah","translations":[{"text":"No! He will surely be thrown into the Crusher."}]},{"id":6184,"verse_number":5,"verse_key":"104:5","text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","transliteration":"Wa maa adraaka mal-hutamah","translations":[{"text":"And what can make you know what is the Crusher?"}]},{"id":6185,"verse_number":6,"verse_key":"104:6","text_uthmani":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","transliteration":"Narul laahil-mooqada","translations":[{"text":"It is the fire of Allah, [eternally] fueled,"}]},{"id":6186,"verse_number":7,"verse_key":"104:7","text_uthmani":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","transliteration":"Al latee tat tali'u 'alalafidah","translations":[{"text":"Which mounts directed at the hearts."}]},{"id":6187,"verse_number":8,"verse_key":"104:8","text_uthmani":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","transliteration":"Innaha 'alaihim moosada","translations":[{"text":"Indeed, Hellfire will be closed down upon them"}]},{"id":6188,"verse_number":9,"verse_key":"104:9","text_uthmani":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","transliteration":"Fee 'amadim-mu mad dadah","translations":[{"text":"In extended columns."}]}]}