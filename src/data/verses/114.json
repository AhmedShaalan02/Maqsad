{"verses":[{"id":6231,"verse_number":1,"verse_key":"114:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","transliteration":"Qul a'uzu birabbin naas","translations":[{"text":"Say, \"I seek refuge in the Lord of mankind,"}]},{"id":6232,"verse_number":2,"verse_key":"114:2","text_uthmani":"مَلِكِ ٱلنَّاسِ","transliteration":"Malikin naas","translations":[{"text":"The Sovereign of mankind."}]},{"id":6233,"verse_number":3,"verse_key":"114:3","text_uthmani":"إِلَٰهِ ٱلنَّاسِ","transliteration":"Ilaahin naas","translations":[{"text":"The God of mankind,"}]},{"id":6234,"verse_number":4,"verse_key":"114:4","text_uthmani":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","transliteration":"Min sharril was waasil khannaas","translations":[{"text":"From the evil of the retreating whisperer -"}]},{"id":6235,"verse_number":5,"verse_key":"114:5","text_uthmani":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","transliteration":"Al lazee yuwas wisu fee sudoorin naas","translations":[{"text":"Who whispers [evil] into the breasts of mankind -"}]},{"id":6236,"verse_number":6,"verse_key":"114:6","text_uthmani":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","transliteration":"Minal jinnati wan naas","translations":[{"text":"From among the jinn and mankind.\""}]}]}