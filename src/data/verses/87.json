{"verses":[{"id":5949,"verse_number":1,"verse_key":"87:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","transliteration":"Sabbihisma Rabbikal A'laa","translations":[{"text":"Exalt the name of your Lord, the Most High,"}]},{"id":5950,"verse_number":2,"verse_key":"87:2","text_uthmani":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","transliteration":"Allazee khalaqa fasawwaa","translations":[{"text":"Who created and proportioned"}]},{"id":5951,"verse_number":3,"verse_key":"87:3","text_uthmani":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","transliteration":"Wallazee qaddara fahadaa","translations":[{"text":"And who destined and [then] guided"}]},{"id":5952,"verse_number":4,"verse_key":"87:4","text_uthmani":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","transliteration":"Wallazeee akhrajal mar'aa","translations":[{"text":"And who brings out the pasture"}]},{"id":5953,"verse_number":5,"verse_key":"87:5","text_uthmani":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","transliteration":"Faja'alahoo ghusaaa'an ahwaa","translations":[{"text":"And [then] makes it black stubble."}]},{"id":5954,"verse_number":6,"verse_key":"87:6","text_uthmani":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","transliteration":"Sanuqri'uka falaa tansaaa","translations":[{"text":"We will make you recite, [O Muhammad], and you will not forget,"}]},{"id":5955,"verse_number":7,"verse_key":"87:7","text_uthmani":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","transliteration":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa","translations":[{"text":"Except what Allah should will. Indeed, He knows what is declared and what is hidden."}]},{"id":5956,"verse_number":8,"verse_key":"87:8","text_uthmani":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","transliteration":"Wa nu-yassiruka lilyusraa","translations":[{"text":"And We will ease you toward ease."}]},{"id":5957,"verse_number":9,"verse_key":"87:9","text_uthmani":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","transliteration":"Fazakkir in nafa'atizzikraa","translations":[{"text":"So remind, if the reminder should benefit;"}]},{"id":5958,"verse_number":10,"verse_key":"87:10","text_uthmani":"سَيَذَّكَّرُ مَن يَخْشَىٰ","transliteration":"Sa yazzakkaru maiyakhshaa","translations":[{"text":"He who fears [Allah] will be reminded."}]},{"id":5959,"verse_number":11,"verse_key":"87:11","text_uthmani":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","transliteration":"Wa yatajannabuhal ashqaa","translations":[{"text":"But the wretched one will avoid it -"}]},{"id":5960,"verse_number":12,"verse_key":"87:12","text_uthmani":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","transliteration":"Allazee yaslan Naaral kubraa","translations":[{"text":"[He] who will [enter and] burn in the greatest Fire,"}]},{"id":5961,"verse_number":13,"verse_key":"87:13","text_uthmani":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","transliteration":"Summa laa yamootu feehaa wa laa yahyaa","translations":[{"text":"Neither dying therein nor living."}]},{"id":5962,"verse_number":14,"verse_key":"87:14","text_uthmani":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","transliteration":"Qad aflaha man tazakkaa","translations":[{"text":"He has certainly succeeded who purifies himself"}]},{"id":5963,"verse_number":15,"verse_key":"87:15","text_uthmani":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","transliteration":"Wa zakaras ma Rabbihee fasallaa","translations":[{"text":"And mentions the name of his Lord and prays."}]},{"id":5964,"verse_number":16,"verse_key":"87:16","text_uthmani":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","transliteration":"Bal tu'siroonal hayaatad dunyaa","translations":[{"text":"But you prefer the worldly life,"}]},{"id":5965,"verse_number":17,"verse_key":"87:17","text_uthmani":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","transliteration":"Wal Aakhiratu khairunw wa abqaa","translations":[{"text":"While the Hereafter is better and more enduring."}]},{"id":5966,"verse_number":18,"verse_key":"87:18","text_uthmani":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","transliteration":"Inna haazaa lafis suhu fil oolaa","translations":[{"text":"Indeed, this is in the former scriptures,"}]},{"id":5967,"verse_number":19,"verse_key":"87:19","text_uthmani":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","transliteration":"Suhufi Ibraaheema wa Moosaa","translations":[{"text":"The scriptures of Abraham and Moses."}]}]}