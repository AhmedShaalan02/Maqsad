{"verses":[{"id":6208,"verse_number":1,"verse_key":"109:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","transliteration":"Qul yaa-ai yuhal kaafiroon","translations":[{"text":"Say, \"O disbelievers,"}]},{"id":6209,"verse_number":2,"verse_key":"109:2","text_uthmani":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","transliteration":"Laa a'budu ma t'abudoon","translations":[{"text":"I do not worship what you worship."}]},{"id":6210,"verse_number":3,"verse_key":"109:3","text_uthmani":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","transliteration":"Wa laa antum 'aabidoona maa a'bud","translations":[{"text":"Nor are you worshippers of what I worship."}]},{"id":6211,"verse_number":4,"verse_key":"109:4","text_uthmani":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","transliteration":"Wa laa ana 'abidum maa 'abattum","translations":[{"text":"Nor will I be a worshipper of what you worship."}]},{"id":6212,"verse_number":5,"verse_key":"109:5","text_uthmani":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","transliteration":"Wa laa antum 'aabidoona ma a'bud","translations":[{"text":"Nor will you be worshippers of what I worship."}]},{"id":6213,"verse_number":6,"verse_key":"109:6","text_uthmani":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","transliteration":"Lakum deenukum wa liya deen.","translations":[{"text":"For you is your religion, and for me is my religion.\""}]}]}