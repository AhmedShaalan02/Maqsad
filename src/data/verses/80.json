{"verses":[{"id":5759,"verse_number":1,"verse_key":"80:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","transliteration":"'Abasa wa tawallaa.","translations":[{"text":"The Prophet frowned and turned away"}]},{"id":5760,"verse_number":2,"verse_key":"80:2","text_uthmani":"أَن جَآءَهُ ٱلْأَعْمَىٰ","transliteration":"An jaa-ahul 'a-maa","translations":[{"text":"Because there came to him the blind man, [interrupting]."}]},{"id":5761,"verse_number":3,"verse_key":"80:3","text_uthmani":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","transliteration":"Wa maa yudreeka la'allahu yaz zakkaa.","translations":[{"text":"But what would make you perceive, [O Muhammad], that perhaps he might be purified"}]},{"id":5762,"verse_number":4,"verse_key":"80:4","text_uthmani":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","transliteration":"Au yaz zak karu fatanfa 'ahuz zikraa.","translations":[{"text":"Or be reminded and the remembrance would benefit him?"}]},{"id":5763,"verse_number":5,"verse_key":"80:5","text_uthmani":"أَمَّا مَنِ ٱسْتَغْنَىٰ","transliteration":"Amma manis taghnaa","translations":[{"text":"As for he who thinks himself without need,"}]},{"id":5764,"verse_number":6,"verse_key":"80:6","text_uthmani":"فَأَنتَ لَهُۥ تَصَدَّىٰ","transliteration":"Fa-anta lahu tasaddaa","translations":[{"text":"To him you give attention."}]},{"id":5765,"verse_number":7,"verse_key":"80:7","text_uthmani":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","transliteration":"Wa ma 'alaika allaa yaz zakka.","translations":[{"text":"And not upon you [is any blame] if he will not be purified."}]},{"id":5766,"verse_number":8,"verse_key":"80:8","text_uthmani":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","transliteration":"Wa amma man jaa-aka yas'a","translations":[{"text":"But as for he who came to you striving [for knowledge]"}]},{"id":5767,"verse_number":9,"verse_key":"80:9","text_uthmani":"وَهُوَ يَخْشَىٰ","transliteration":"Wahuwa yakhshaa,","translations":[{"text":"While he fears [Allah],"}]},{"id":5768,"verse_number":10,"verse_key":"80:10","text_uthmani":"فَأَنتَ عَنْهُ تَلَهَّىٰ","transliteration":"Fa-anta 'anhu talah haa.","translations":[{"text":"From him you are distracted."}]},{"id":5769,"verse_number":11,"verse_key":"80:11","text_uthmani":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","transliteration":"Kalla innaha tazkirah","translations":[{"text":"No! Indeed, these verses are a reminder;"}]},{"id":5770,"verse_number":12,"verse_key":"80:12","text_uthmani":"فَمَن شَآءَ ذَكَرَهُۥ","transliteration":"Faman shaa a zakarah","translations":[{"text":"So whoever wills may remember it."}]},{"id":5771,"verse_number":13,"verse_key":"80:13","text_uthmani":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","transliteration":"Fi suhufim mukar rama,","translations":[{"text":"[It is recorded] in honored sheets,"}]},{"id":5772,"verse_number":14,"verse_key":"80:14","text_uthmani":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","transliteration":"Marfoo'atim mutah hara,","translations":[{"text":"Exalted and purified,"}]},{"id":5773,"verse_number":15,"verse_key":"80:15","text_uthmani":"بِأَيْدِى سَفَرَةٍۢ","transliteration":"Bi'aidee safara","translations":[{"text":"[Carried] by the hands of messenger-angels,"}]},{"id":5774,"verse_number":16,"verse_key":"80:16","text_uthmani":"كِرَامٍۭ بَرَرَةٍۢ","transliteration":"Kiraamim bararah.","translations":[{"text":"Noble and dutiful."}]},{"id":5775,"verse_number":17,"verse_key":"80:17","text_uthmani":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","transliteration":"Qutilal-insanu maa akfarah.","translations":[{"text":"Cursed is man; how disbelieving is he."}]},{"id":5776,"verse_number":18,"verse_key":"80:18","text_uthmani":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","transliteration":"Min aiyyi shai-in Khalaq","translations":[{"text":"From what substance did He create him?"}]},{"id":5777,"verse_number":19,"verse_key":"80:19","text_uthmani":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","transliteration":"Min nutfah; khalaqahu faqad-darah.","translations":[{"text":"From a sperm-drop He created him and destined for him;"}]},{"id":5778,"verse_number":20,"verse_key":"80:20","text_uthmani":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","transliteration":"Thummas sabeela yas-sarah","translations":[{"text":"Then He eased the way for him;"}]},{"id":5779,"verse_number":21,"verse_key":"80:21","text_uthmani":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","transliteration":"Thumma amatahu fa-aqbarah","translations":[{"text":"Then He causes his death and provides a grave for him."}]},{"id":5780,"verse_number":22,"verse_key":"80:22","text_uthmani":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","transliteration":"Thumma iza shaa-a ansharah","translations":[{"text":"Then when He wills, He will resurrect him."}]},{"id":5781,"verse_number":23,"verse_key":"80:23","text_uthmani":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","transliteration":"Kalla lamma yaqdi maa amarah.","translations":[{"text":"No! Man has not yet accomplished what He commanded him."}]},{"id":5782,"verse_number":24,"verse_key":"80:24","text_uthmani":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","transliteration":"Falyanzuril insanu ilaa ta-amih","translations":[{"text":"Then let mankind look at his food -"}]},{"id":5783,"verse_number":25,"verse_key":"80:25","text_uthmani":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","transliteration":"Anna sabab nalmaa-a sabba.","translations":[{"text":"How We poured down water in torrents,"}]},{"id":5784,"verse_number":26,"verse_key":"80:26","text_uthmani":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","transliteration":"Thumma sha qaqnal-arda shaqqa.","translations":[{"text":"Then We broke open the earth, splitting [it with sprouts],"}]},{"id":5785,"verse_number":27,"verse_key":"80:27","text_uthmani":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","transliteration":"Fa ambatna feeha habba","translations":[{"text":"And caused to grow within it grain"}]},{"id":5786,"verse_number":28,"verse_key":"80:28","text_uthmani":"وَعِنَبًۭا وَقَضْبًۭا","transliteration":"Wa 'inabaw-wa qadba","translations":[{"text":"And grapes and herbage"}]},{"id":5787,"verse_number":29,"verse_key":"80:29","text_uthmani":"وَزَيْتُونًۭا وَنَخْلًۭا","transliteration":"Wa zaitoonaw wanakh la'","translations":[{"text":"And olive and palm trees"}]},{"id":5788,"verse_number":30,"verse_key":"80:30","text_uthmani":"وَحَدَآئِقَ غُلْبًۭا","transliteration":"Wa hadaa-iqa ghulba","translations":[{"text":"And gardens of dense shrubbery"}]},{"id":5789,"verse_number":31,"verse_key":"80:31","text_uthmani":"وَفَٰكِهَةًۭ وَأَبًّۭا","transliteration":"Wa faki hataw-wa abba.","translations":[{"text":"And fruit and grass -"}]},{"id":5790,"verse_number":32,"verse_key":"80:32","text_uthmani":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","transliteration":"Mata'al-lakum wa li-an'amikum.","translations":[{"text":"[As] enjoyment for you and your grazing livestock."}]},{"id":5791,"verse_number":33,"verse_key":"80:33","text_uthmani":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","transliteration":"Faiza jaa-atis saakhah.","translations":[{"text":"But when there comes the Deafening Blast"}]},{"id":5792,"verse_number":34,"verse_key":"80:34","text_uthmani":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","transliteration":"Yauma yafir-rul mar-u min akheeh","translations":[{"text":"On the Day a man will flee from his brother"}]},{"id":5793,"verse_number":35,"verse_key":"80:35","text_uthmani":"وَأُمِّهِۦ وَأَبِيهِ","transliteration":"Wa ummihee wa abeeh","translations":[{"text":"And his mother and his father"}]},{"id":5794,"verse_number":36,"verse_key":"80:36","text_uthmani":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","transliteration":"Wa sahi batihee wa baneeh.","translations":[{"text":"And his wife and his children,"}]},{"id":5795,"verse_number":37,"verse_key":"80:37","text_uthmani":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","transliteration":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh","translations":[{"text":"For every man, that Day, will be a matter adequate for him."}]},{"id":5796,"verse_number":38,"verse_key":"80:38","text_uthmani":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","transliteration":"Wujoo huny-yauma-izim-musfira;","translations":[{"text":"[Some] faces, that Day, will be bright -"}]},{"id":5797,"verse_number":39,"verse_key":"80:39","text_uthmani":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","transliteration":"Dahi katum mustab shirah","translations":[{"text":"Laughing, rejoicing at good news."}]},{"id":5798,"verse_number":40,"verse_key":"80:40","text_uthmani":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","transliteration":"Wa wujoohuy yauma-izin 'alaiha ghabar a","translations":[{"text":"And [other] faces, that Day, will have upon them dust."}]},{"id":5799,"verse_number":41,"verse_key":"80:41","text_uthmani":"تَرْهَقُهَا قَتَرَةٌ","transliteration":"Tarhaquha qatarah.","translations":[{"text":"Blackness will cover them."}]},{"id":5800,"verse_number":42,"verse_key":"80:42","text_uthmani":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","transliteration":"Ulaa-ika humul-kafa ratul-fajarah.","translations":[{"text":"Those are the disbelievers, the wicked ones."}]}]}