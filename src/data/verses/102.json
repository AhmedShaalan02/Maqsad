{"verses":[{"id":6169,"verse_number":1,"verse_key":"102:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","transliteration":"Al haaku mut takathur","translations":[{"text":"Competition in [worldly] increase diverts you"}]},{"id":6170,"verse_number":2,"verse_key":"102:2","text_uthmani":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","transliteration":"Hatta zurtumul-maqaabir","translations":[{"text":"Until you visit the graveyards."}]},{"id":6171,"verse_number":3,"verse_key":"102:3","text_uthmani":"كَلَّا سَوْفَ تَعْلَمُونَ","transliteration":"Kalla sawfa ta'lamoon","translations":[{"text":"No! You are going to know."}]},{"id":6172,"verse_number":4,"verse_key":"102:4","text_uthmani":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","transliteration":"Thumma kalla sawfa ta'lamoon","translations":[{"text":"Then no! You are going to know."}]},{"id":6173,"verse_number":5,"verse_key":"102:5","text_uthmani":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","transliteration":"Kalla law ta'lamoona 'ilmal yaqeen","translations":[{"text":"No! If you only knew with knowledge of certainty..."}]},{"id":6174,"verse_number":6,"verse_key":"102:6","text_uthmani":"لَتَرَوُنَّ ٱلْجَحِيمَ","transliteration":"Latara-wun nal jaheem","translations":[{"text":"You will surely see the Hellfire."}]},{"id":6175,"verse_number":7,"verse_key":"102:7","text_uthmani":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","transliteration":"Thumma latara wunnaha 'ainal yaqeen","translations":[{"text":"Then you will surely see it with the eye of certainty."}]},{"id":6176,"verse_number":8,"verse_key":"102:8","text_uthmani":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","transliteration":"Thumma latus alunna yauma-izin 'anin na'eem","translations":[{"text":"Then you will surely be asked that Day about pleasure."}]}]}