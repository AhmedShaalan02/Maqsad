{"verses":[{"id":6091,"verse_number":1,"verse_key":"94:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","transliteration":"Alam nashrah laka sadrak","translations":[{"text":"Did We not expand for you, [O Muhammad], your breast?"}]},{"id":6092,"verse_number":2,"verse_key":"94:2","text_uthmani":"وَوَضَعْنَا عَنكَ وِزْرَكَ","transliteration":"Wa wa d'ana 'anka wizrak","translations":[{"text":"And We removed from you your burden"}]},{"id":6093,"verse_number":3,"verse_key":"94:3","text_uthmani":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","transliteration":"Allazee anqada zahrak","translations":[{"text":"Which had weighed upon your back"}]},{"id":6094,"verse_number":4,"verse_key":"94:4","text_uthmani":"وَرَفَعْنَا لَكَ ذِكْرَكَ","transliteration":"Wa raf 'ana laka zikrak","translations":[{"text":"And raised high for you your repute."}]},{"id":6095,"verse_number":5,"verse_key":"94:5","text_uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","transliteration":"Fa inna ma'al usri yusra","translations":[{"text":"For indeed, with hardship [will be] ease."}]},{"id":6096,"verse_number":6,"verse_key":"94:6","text_uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","transliteration":"Inna ma'al 'usri yusra","translations":[{"text":"Indeed, with hardship [will be] ease."}]},{"id":6097,"verse_number":7,"verse_key":"94:7","text_uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","transliteration":"Fa iza faragh ta fansab","translations":[{"text":"So when you have finished [your duties], then stand up [for worship]."}]},{"id":6098,"verse_number":8,"verse_key":"94:8","text_uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","transliteration":"Wa ilaa rabbika far ghab","translations":[{"text":"And to your Lord direct [your] longing."}]}]}