{"verses":[{"id":5968,"verse_number":1,"verse_key":"88:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","transliteration":"Hal ataaka hadeesul ghaashiyah","translations":[{"text":"Has there reached you the report of the Overwhelming [event]?"}]},{"id":5969,"verse_number":2,"verse_key":"88:2","text_uthmani":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","transliteration":"Wujoohuny yawma 'izin khaashi'ah","translations":[{"text":"[Some] faces, that Day, will be humbled,"}]},{"id":5970,"verse_number":3,"verse_key":"88:3","text_uthmani":"عَامِلَةٌۭ نَّاصِبَةٌۭ","transliteration":"'Aamilatun naasibah","translations":[{"text":"Working [hard] and exhausted."}]},{"id":5971,"verse_number":4,"verse_key":"88:4","text_uthmani":"تَصْلَىٰ نَارًا حَامِيَةًۭ","transliteration":"Taslaa naaran haamiyah","translations":[{"text":"They will [enter to] burn in an intensely hot Fire."}]},{"id":5972,"verse_number":5,"verse_key":"88:5","text_uthmani":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","transliteration":"Tusqaa min 'aynin aaniyah","translations":[{"text":"They will be given drink from a boiling spring."}]},{"id":5973,"verse_number":6,"verse_key":"88:6","text_uthmani":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","transliteration":"Laisa lahum ta'aamun illaa min daree'","translations":[{"text":"For them there will be no food except from a poisonous, thorny plant"}]},{"id":5974,"verse_number":7,"verse_key":"88:7","text_uthmani":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","transliteration":"Laa yusminu wa laa yughnee min joo'","translations":[{"text":"Which neither nourishes nor avails against hunger."}]},{"id":5975,"verse_number":8,"verse_key":"88:8","text_uthmani":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","transliteration":"Wujoohuny yawma 'izin naa'imah","translations":[{"text":"[Other] faces, that Day, will show pleasure."}]},{"id":5976,"verse_number":9,"verse_key":"88:9","text_uthmani":"لِّسَعْيِهَا رَاضِيَةٌۭ","transliteration":"Lisa'yihaa raadiyah","translations":[{"text":"With their effort [they are] satisfied"}]},{"id":5977,"verse_number":10,"verse_key":"88:10","text_uthmani":"فِى جَنَّةٍ عَالِيَةٍۢ","transliteration":"Fee jannatin 'aaliyah","translations":[{"text":"In an elevated garden,"}]},{"id":5978,"verse_number":11,"verse_key":"88:11","text_uthmani":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","transliteration":"Laa tasma'u feehaa laaghiyah","translations":[{"text":"Wherein they will hear no unsuitable speech."}]},{"id":5979,"verse_number":12,"verse_key":"88:12","text_uthmani":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","transliteration":"Feehaa 'aynun jaariyah","translations":[{"text":"Within it is a flowing spring."}]},{"id":5980,"verse_number":13,"verse_key":"88:13","text_uthmani":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","transliteration":"Feehaa sururum marfoo'ah","translations":[{"text":"Within it are couches raised high"}]},{"id":5981,"verse_number":14,"verse_key":"88:14","text_uthmani":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","transliteration":"Wa akwaabum mawdoo 'ah","translations":[{"text":"And cups put in place"}]},{"id":5982,"verse_number":15,"verse_key":"88:15","text_uthmani":"وَنَمَارِقُ مَصْفُوفَةٌۭ","transliteration":"Wa namaariqu masfoofah","translations":[{"text":"And cushions lined up"}]},{"id":5983,"verse_number":16,"verse_key":"88:16","text_uthmani":"وَزَرَابِىُّ مَبْثُوثَةٌ","transliteration":"Wa zaraabiyyu mabsoosah","translations":[{"text":"And carpets spread around."}]},{"id":5984,"verse_number":17,"verse_key":"88:17","text_uthmani":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","transliteration":"Afalaa yanzuroona ilalibili kaifa khuliqat","translations":[{"text":"Then do they not look at the camels - how they are created?"}]},{"id":5985,"verse_number":18,"verse_key":"88:18","text_uthmani":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","transliteration":"Wa ilas samaaa'i kaifa rufi'at","translations":[{"text":"And at the sky - how it is raised?"}]},{"id":5986,"verse_number":19,"verse_key":"88:19","text_uthmani":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","transliteration":"Wa ilal jibaali kaifa nusibat","translations":[{"text":"And at the mountains - how they are erected?"}]},{"id":5987,"verse_number":20,"verse_key":"88:20","text_uthmani":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","transliteration":"Wa ilal ardi kaifa sutihat","translations":[{"text":"And at the earth - how it is spread out?"}]},{"id":5988,"verse_number":21,"verse_key":"88:21","text_uthmani":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","transliteration":"Fazakkir innama anta Muzakkir","translations":[{"text":"So remind, [O Muhammad]; you are only a reminder."}]},{"id":5989,"verse_number":22,"verse_key":"88:22","text_uthmani":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","transliteration":"Lasta 'alaihim bimusaitir","translations":[{"text":"You are not over them a controller."}]},{"id":5990,"verse_number":23,"verse_key":"88:23","text_uthmani":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","transliteration":"Illaa man tawallaa wa kafar","translations":[{"text":"However, he who turns away and disbelieves -"}]},{"id":5991,"verse_number":24,"verse_key":"88:24","text_uthmani":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","transliteration":"Fa yu'azzibuhul laahul 'azaabal akbar","translations":[{"text":"Then Allah will punish him with the greatest punishment."}]},{"id":5992,"verse_number":25,"verse_key":"88:25","text_uthmani":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","transliteration":"Innaa ilainaaa iyaabahum","translations":[{"text":"Indeed, to Us is their return."}]},{"id":5993,"verse_number":26,"verse_key":"88:26","text_uthmani":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","transliteration":"Summa inna 'alainaa hisaabahum","translations":[{"text":"Then indeed, upon Us is their account."}]}]}