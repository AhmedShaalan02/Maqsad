{"verses":[{"id":6158,"verse_number":1,"verse_key":"101:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","transliteration":"Al qaari'ah","translations":[{"text":"The Striking Calamity -"}]},{"id":6159,"verse_number":2,"verse_key":"101:2","text_uthmani":"مَا ٱلْقَارِعَةُ","transliteration":"Mal qaariah","translations":[{"text":"What is the Striking Calamity?"}]},{"id":6160,"verse_number":3,"verse_key":"101:3","text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","transliteration":"Wa maa adraaka mal qaari'ah","translations":[{"text":"And what can make you know what is the Striking Calamity?"}]},{"id":6161,"verse_number":4,"verse_key":"101:4","text_uthmani":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","transliteration":"Yauma ya koonun naasu kal farashil mabthooth","translations":[{"text":"It is the Day when people will be like moths, dispersed,"}]},{"id":6162,"verse_number":5,"verse_key":"101:5","text_uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","transliteration":"Wa ta koonul jibalu kal 'ihnil manfoosh","translations":[{"text":"And the mountains will be like wool, fluffed up."}]},{"id":6163,"verse_number":6,"verse_key":"101:6","text_uthmani":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","transliteration":"Fa-amma man thaqulat mawa zeenuh","translations":[{"text":"Then as for one whose scales are heavy [with good deeds],"}]},{"id":6164,"verse_number":7,"verse_key":"101:7","text_uthmani":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","transliteration":"Fahuwa fee 'ishatir raadiyah","translations":[{"text":"He will be in a pleasant life."}]},{"id":6165,"verse_number":8,"verse_key":"101:8","text_uthmani":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","transliteration":"Wa amma man khaffat mawa zeenuh","translations":[{"text":"But as for one whose scales are light,"}]},{"id":6166,"verse_number":9,"verse_key":"101:9","text_uthmani":"فَأُمُّهُۥ هَاوِيَةٌۭ","transliteration":"Fa-ummuhu haawiyah","translations":[{"text":"His refuge will be an abyss."}]},{"id":6167,"verse_number":10,"verse_key":"101:10","text_uthmani":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","transliteration":"Wa maa adraaka maa hiyah","translations":[{"text":"And what can make you know what that is?"}]},{"id":6168,"verse_number":11,"verse_key":"101:11","text_uthmani":"نَارٌ حَامِيَةٌۢ","transliteration":"Naarun hamiyah","translations":[{"text":"It is a Fire, intensely hot."}]}]}