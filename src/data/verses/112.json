{"verses":[{"id":6222,"verse_number":1,"verse_key":"112:1","text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","transliteration":"Qul huwal laahu ahad","translations":[{"text":"Say, \"He is Allah, [who is] One,"}]},{"id":6223,"verse_number":2,"verse_key":"112:2","text_uthmani":"ٱللَّهُ ٱلصَّمَدُ","transliteration":"Allah hus-samad","translations":[{"text":"Allah, the Eternal Refuge."}]},{"id":6224,"verse_number":3,"verse_key":"112:3","text_uthmani":"لَمْ يَلِدْ وَلَمْ يُولَدْ","transliteration":"Lam yalid wa lam yoolad","translations":[{"text":"He neither begets nor is born,"}]},{"id":6225,"verse_number":4,"verse_key":"112:4","text_uthmani":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","transliteration":"Wa lam yakul-lahu kufuwan ahad","translations":[{"text":"Nor is there to Him any equivalent.\""}]}]}